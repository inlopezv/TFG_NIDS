FROM debian:bullseye-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m xonotic
USER xonotic
WORKDIR /home/xonotic

# 1. Descargamos y descomprimimos en 'staging'
RUN wget https://dl.xonotic.org/xonotic-0.8.6.zip -O xonotic.zip && \
    unzip -q xonotic.zip -d /home/xonotic/staging && \
    rm xonotic.zip

WORKDIR /home/xonotic/Xonotic

EXPOSE 26000/udp

# 2. Comando mejorado: usa 'cp -r .../.' para evitar problemas con asteriscos y da feedback en texto
CMD /bin/bash -c "\
    if [ -z \"\$(ls -A /home/xonotic/Xonotic 2>/dev/null)\" ]; then \
        echo '=> Directorio local vacio. Copiando archivos base...'; \
        cp -r /home/xonotic/staging/Xonotic/. /home/xonotic/Xonotic/; \
        echo '=> Copia finalizada.'; \
    else \
        echo '=> Los archivos ya existen en el volumen local. Saltando copia.'; \
    fi && \
    rm -f /home/xonotic/.xonotic/lock* && \
    exec ./xonotic-linux64-dedicated -sessionid kaliserver" 